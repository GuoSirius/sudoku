{
  "name": "数独 Sudoku",
  "short_name": "数独",
  "description": "可安装的网页数独：计时、个人排行榜、历史复盘、中途暂存，纯前端离线可用。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1117",
  "theme_color": "#4f46e5",
  "orientation": "portrait",
