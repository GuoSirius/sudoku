# Supabase 数据库连接串（仅本地部署脚本 tools/deploy-schema.mjs 使用，绝不可提交真实 .env）
#
# 复制本文件为 .env：
#   cp .env.example .env
# 然后把下面尖括号里的内容换成你的真实密码（从 Supabase → Settings → Database → Connection string 复制 URI 格式）。
#
# 注意：
#   - .env 已被 .gitignore 忽略，不会进版本库；本 .env.example 模板会进版本库（不含任何真实密码）。
#   - 复制后请保留 postgres 用户名、db.<project-ref>.supabase.co 主机、5432 端口、/postgres 库名，只改密码部分。
#   - project-ref 即 Project URL 里 https:// 和 .supabase.co 之间的那段（本仓库示例为 oafefnbyzajzdejelhsw）。
SUPABASE_DB_URL="postgresql://postgres:<你的数据库密码>@db.oafefnbyzajzdejelhsw.supabase.co:5432/postgres"
