{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sudoku",
  "version": "1.0.4",
  "identifier": "cn.sudoku.game",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd .. && npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "数独 Sudoku",
        "width": 420,
        "height": 760,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "globalShortcut": {},
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/GuoSirius/sudoku/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MUU3MkI1NjVDRjJDQTcKUldTbkxNOWx0WEllMmZUeWVIMC9ZTFh2OE1IU053U2oyWmppTSs4QS9WTm9mL1NJWTRJRXlNZE0K",
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
