{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "数独 Sudoku",
  "version": "1.0.0",
  "identifier": "cn.sudoku.game",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd .. && npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "数独 Sudoku",
        "width": 420,
        "height": 760,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "globalShortcut": {}
  }
}
